{
  "source": {
    "include": [
      "apps/desktop/src/**/*.ts",
      "apps/desktop/src/**/*.tsx",
      "services/agent-sidecar/src/**/*.py"
    ]
  },
  "test": {
    "command": [
      "node",
      "scripts/quality-metrics.mjs",
      "--run",
      "--report",
      "coverage/quality-metrics.json"
    ],
    "timeout_seconds": 1200
  },
  "mutation": {
    "test_command": [
      "python3",
      "scripts/quality-mutation-tests.py"
    ],
    "workers": "auto",
    "max_mutants": 0,
    "timeout_seconds": 1200
  },
  "metrics": {
    "command": [
      "node",
      "scripts/quality-metrics.mjs",
      "--report",
      "{report}"
    ],
    "report": "{report}",
    "timeout_seconds": 1200
  },
  "dependencies": {
    "command": [
      "node",
      "scripts/quality-dependency-edges.mjs",
      "--report",
      "{report}"
    ],
    "edges_report": "{report}"
  }
}
