{
  "schema_version": 1,
  "format_lint": {
    "max_violations": 0
  },
  "types": {
    "max_errors": 0
  },
  "contracts": {
    "max_violations": 0
  },
  "metrics": {
    "max_test_failures": 0,
    "coverage_limit": 100,
    "complexity_limit": 6,
    "craap_limit": 6
  },
  "file_loc": {
    "max_lines": 600
  },
  "dead_code": {
    "max_findings": 0
  },
  "flaky_tests": {
    "runs": 3,
    "max_failures": 0
  },
  "mutation": {
    "max_surviving_mutants": 0
  },
  "dependencies": {
    "max_violations": 0
  }
}
