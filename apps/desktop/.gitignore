# Scratch compile output for the real-Electron boot test
# (electron/main/index.electron.test.ts) — built on the fly from the real
# electron/**/*.ts sources via tsconfig.build.json, never hand-edited, never
# shipped.
dist_boot/

# Leftover scratch output from superseded merge candidates
# (tsconfig.build_a.json / tsconfig.build_b.json, both removed each time).
# The directories are stale build artefacts, not source; kept ignored so a
# future `git add -A` cannot pick them up. Reappears under a fresh name each
# time a new build-candidate round runs (dist_a/dist_b, then dist_boot_a/
# dist_boot_b) — add the new pattern here rather than deleting the directory
# with rm -rf, which this repo's background agents are forbidden from running.
dist_a/
dist_b/
dist_boot_a/
dist_boot_b/

# Scratch compile output for electron/renderer/tsconfig.json — the renderer
# subproject's own DOM-lib typecheck target, never hand-edited, never shipped.
dist_renderer/

# Electron packaging compile output and proof artifacts. Source and configs
# live beside these directories; their generated JS, fixture bundles and DMGs
# must never be staged by `git add -A`.
dist_pkg_a/
dist_pkg_b/
dist_package/
pkgout_a/
release/
release_b/
release_b_proof*/
build_b/
resources_b/
