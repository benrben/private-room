{
  "name": "@arcelle/desktop",
  "private": true,
  "version": "0.26.11",
  "type": "module",
  "description": "Arcelle's Electron main process, preload bridge, and macOS packaging workspace.",
  "main": "dist_package/src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers 4",
    "test:unit": "vitest run --maxWorkers 4 --exclude src/main/index.electron.test.ts",
    "test:electron-real": "vitest run --maxWorkers 1 --run src/main/index.electron.test.ts",
    "test:packaging": "vitest run --config scripts/vitest.config.mjs",
    "test:watch": "vitest",
    "e2e": "scripts/e2e.sh",
    "e2e:smoke": "node ../../tests/e2e/desktop/electron-smoke.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -b tsconfig.renderer.json",
    "build:renderer": "tsc -b tsconfig.renderer.json && vite build",
    "build": "npm run build:renderer && tsc -p tsconfig.package.json && node scripts/bundlePreload.mjs && node scripts/copyRuntimeAssets.mjs && node scripts/copyRenderer.mjs",
    "check:versions": "node scripts/versionFiles.mjs ../..",
    "package:dir": "scripts/package.sh --dir",
    "package:mac": "scripts/package.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@ghostery/adblocker-electron": "^2.11.0",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@mozilla/readability": "^0.6.0",
    "@noble/hashes": "2.4.0",
    "@jsquash/jxl": "1.3.0",
    "@kenjiuno/msgreader": "1.28.0",
    "ag-psd": "31.0.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "chokidar": "^5.0.0",
    "docx-preview": "^0.4.0",
    "fflate": "^0.8.3",
    "foliate-js": "1.0.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "koffi": "^3.1.6",
    "libarchive.js": "2.0.2",
    "libsodium-wrappers": "^0.8.4",
    "linkedom": "^0.18.5",
    "mermaid": "11.17.2",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4",
    "undici": "^8.10.0",
    "utif": "3.1.0",
    "wavesurfer.js": "^7.12.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zetajs": "1.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
