{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "dist_main",
    "rootDir": "."
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "cli/**/*.ts"],
  // Excluded because the renderer lane needs the "DOM" lib this (Node-only)
  // program deliberately omits -- NOT because it goes unchecked: it is a
  // separate project with its own tsconfig, and `npm run typecheck` invokes
  // that one too. Adding renderer sources without updating that script would
  // leave them typechecked by nothing.
  "exclude": ["src/**/*.test.ts", "src/renderer"]
}
