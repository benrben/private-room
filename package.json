{
  "name": "arcelle",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.26.1",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:dry-run": "node scripts/clean.mjs --dry-run",
    "dev": "npm --prefix electron-migration/electron-app run dev",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm --prefix electron-migration/electron-app run build:main",
    "build:renderer": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "npm run typecheck && npm run lint:py",
    "lint:py": "cd sidecar && uvx ruff check .",
    "preview": "vite preview",
    "test": "npm --prefix electron-migration/electron-app test && npm run test:sidecar",
    "test:electron": "npm --prefix electron-migration/electron-app test",
    "test:packaging": "npm --prefix electron-migration/electron-app run test:packaging",
    "test:page": "node --test \"e2e/page-script/*.test.mjs\"",
    "test:mock": "node qa/check-mock-coverage.mjs --bridge=electron",
    "test:sidecar": "cd sidecar && uv run pytest -q",
    "preflight": "npm run lint && npm test && npm run build",
    "package:dir": "npm --prefix electron-migration/electron-app run package:dir",
    "package:mac": "npm --prefix electron-migration/electron-app run package:mac",
    "e2e": "npm --prefix electron-migration/electron-app run e2e",
    "e2e:qa": "wdio run e2e/wdio.qa.conf.mjs",
    "e2e:mock": "node e2e/mock-ollama.mjs",
    "capture": "wdio run e2e/wdio.capture.conf.mjs"
  },
  "dependencies": {
    "docx-preview": "^0.3.7",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "wavesurfer.js": "^7.12.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.9.1",
    "@wdio/local-runner": "^9.9.1",
    "@wdio/mocha-framework": "^9.9.1",
    "@wdio/spec-reporter": "^9.9.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.12"
    }
  }
}
