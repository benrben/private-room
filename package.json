{
  "name": "arcelle",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "npm run typecheck && npm run lint:py",
    "lint:py": "cd sidecar && uvx ruff check .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "scripts/preflight.sh --suites",
    "test:page": "node --test \"e2e/page-script/*.test.mjs\"",
    "test:mock": "node qa/check-mock-coverage.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:sidecar": "cd sidecar && uv run pytest -q",
    "preflight": "scripts/preflight.sh",
    "e2e": "wdio run e2e/wdio.conf.mjs",
    "e2e:qa": "wdio run e2e/wdio.qa.conf.mjs",
    "e2e:mock": "node e2e/mock-ollama.mjs",
    "capture": "wdio run e2e/wdio.capture.conf.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "docx-preview": "^0.4.0",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.9.1",
    "typescript": "~7.0.2",
    "vite": "^8.1.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.12"
    }
  }
}
