{
  "name": "arcelle-electron",
  "private": true,
  "version": "0.26.0",
  "type": "module",
  "description": "Arcelle's Electron main process, preload bridge, and macOS packaging workspace.",
  "main": "dist_package/electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:packaging": "vitest run --config scripts/vitest.config.mjs",
    "test:watch": "vitest",
    "e2e": "scripts/e2e.sh",
    "e2e:smoke": "node ../../e2e/electron-smoke.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p electron/renderer/tsconfig.json --noEmit",
    "build:renderer": "npm --prefix ../.. run build:renderer",
    "build:main": "npm run build:renderer && tsc -p tsconfig.package.json && node scripts/bundlePreload.mjs && node scripts/copyRuntimeAssets.mjs && node scripts/copyRenderer.mjs",
    "check:versions": "node scripts/versionFiles.mjs ../..",
    "package:dir": "scripts/package.sh --dir",
    "package:mac": "scripts/package.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@ghostery/adblocker-electron": "^2.11.0",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "chokidar": "^5.0.0",
    "koffi": "^3.1.6",
    "libsodium-wrappers": "^0.8.4",
    "linkedom": "^0.18.5",
    "sharp": "^0.35.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}
