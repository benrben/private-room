{
  // Real emit of the real `electron/**/*.ts` sources, for the one thing that
  // cannot run from TypeScript directly: launching the actual Electron binary
  // (`electron/main/index.electron.test.ts`). Adds only `noEmit: false` and a
  // scratch `outDir` on top of the real `tsconfig.json`, so a build failure
  // here is a build failure of the real source, not of some other config.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "dist_boot"
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["electron/**/*.test.ts", "electron/renderer"]
}
