{
  "compilerOptions": {
    "composite": true,
    // `tsc -b` (npm run typecheck / npm run build) type-checks this project too.
    // A referenced composite project may not disable emit (TS6310), so the
    // output goes somewhere harmless instead: emitting next to the source would
    // drop a stale vite.config.js that shadows vite.config.ts for Vite.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
