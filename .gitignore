# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
# `tsc -b` incremental caches. tsconfig.json/tsconfig.node.json point these at
# node_modules/.tmp/; this catches a stray one from a hand-run tsc.
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# MCP tool scratch output (Playwright MCP) — not source
.playwright-mcp/

# Model weights — too big to commit. electron-builder bundles this directory,
# so every one has to be fetched into place before
# a release build or the bundle ships without it: Whisper (~574 MB), TitaNet
# diarization (~40 MB), Silero VAD (~1 MB). See RELEASING.md for the exact URLs.
# Dropping Whisper from the bundle to shrink the update would need a first-use
# download to exist first; it does not, so it stays bundled.
electron-migration/electron-app/assets/models/*.bin
electron-migration/electron-app/assets/models/*.onnx

# Arcelle project files are user data, never source
*.roomai
*.arcelle
# Exception: committed compatibility fixtures, generated by the real app's own
# create-room/rekey path — the plan's
# "fixture .room opened by CI forever" parity gate for the DB migration.
!electron-migration/spikes/s1-db-compat/fixtures/*.roomai
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Python agent sidecar (ADD-33) ---
# Byte-compiled files, caches, and test/type-check artifacts — never source.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Local virtualenvs, if a dev creates one inside the repo tree.
.venv/
venv/
# Never commit a dotenv. `langgraph dev` and the LangGraph Studio docs both
# suggest a local .env; this repo's privacy guarantee (SPEC §6) means such a
# file must never reach the tree — and disable_tracing() strips LANGSMITH_*/
# LANGCHAIN_* at import anyway, so nothing here is meant to carry one.
.env
.env.*
!.env.example
# `langgraph dev` (sidecar/devtools/studio.py) cloudpickles threads, checkpoints
# and the store into the CWD in PLAINTEXT — real question text, next to the
# SQLCipher DB. Ignoring it is not enough: run Studio with
# LANGGRAPH_DISABLE_FILE_PERSISTENCE=true, and delete sidecar/.langgraph_api/
# after any session that wrote one anyway.
.langgraph_api/
# PyInstaller packaging: build dir + isolated build venv for a release build.
# (dist/ is already covered by the bare `dist` rule above.) The .spec file is
# REGENERATED by build-sidecar.sh on every run — the flags in that script are
# the real input, so an edited spec would be silently overwritten. Never track it.
sidecar/build/
sidecar/.build-venv/
sidecar/*.spec
*.spec.bak
# The PyInstaller sidecar output is a build artifact, rebuilt per release.
sidecar/dist/
# Screenshots written by the opt-in capture specs (e2e/capture-specs/*.mjs).
# Regenerated on every run and read once, by eye — build output, not evidence.
qa-shots/

# Screenshots written by the layout camera (e2e/qa-specs/create-look.e2e.mjs).
# Evidence for a person to look at, not an artefact to version.
qa/shots/

# Temporary source bundles assembled for planning or handoff. The Markdown
# records in pm-request/ are source; the staged archives are reproducible.
pm-request/_stage/

# Local pre-migration app and sidecar backups. These contain generated app
# bundles and user data, and are never project source.
.arcelle-app-backups/
